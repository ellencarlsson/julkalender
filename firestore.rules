rules_version = '2';

// Door N opens December N, 2026 at 07:00 Europe/Stockholm (06:00 UTC).
// request.time is Google's server clock, so changing the device clock opens nothing.
// Keep the schedule in sync with lib/unlock-time.js.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email == "carlssonellen@live.se"
        && request.auth.token.email_verified == true;
    }

    function isValidDoor(door) {
      return door.matches('^([1-9]|1[0-9]|2[0-4])$');
    }

    function unlockTime(day) {
      return timestamp.date(2026, 12, day) + duration.value(6, 'h');
    }

    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    match /doors/{door} {
      // Only doors 1-24 are readable, also for the admin, so the temporary test door 25 is always locked.
      allow read: if isValidDoor(door)
        && (isAdmin() || (isSignedIn() && request.time >= unlockTime(int(door))));
      allow write: if isAdmin();
    }

    // Side quests are not tied to a door; they become visible together with door 1.
    match /sidequests/{quest} {
      allow read: if isAdmin() || (isSignedIn() && request.time >= unlockTime(1));
      allow write: if isAdmin();
    }

    // Typing race results: every player sees the leaderboard, but only writes their own row, only a
    // faster time, and can only mark it as Ellen's when signed in as Ellen.
    function isValidResult(uid) {
      let result = request.resource.data;
      return isSignedIn() && request.auth.uid == uid
        && result.keys().hasOnly(['name', 'timeMs', 'ellen', 'updatedAt'])
        && result.name is string && result.name.size() <= 60
        && result.timeMs is int && result.timeMs > 0
        && result.ellen == isAdmin()
        && result.updatedAt == request.time;
    }

    match /leaderboards/{door}/results/{uid} {
      allow read: if isSignedIn() && isValidDoor(door);
      allow create: if isValidDoor(door) && isValidResult(uid);
      allow update: if isValidDoor(door) && isValidResult(uid) && request.resource.data.timeMs < resource.data.timeMs;
    }

    match /final/{doc} {
      allow read: if isAdmin()
        || (isSignedIn() && doc == "message" && request.time >= unlockTime(24));
      allow write: if isAdmin();
    }
  }
}
